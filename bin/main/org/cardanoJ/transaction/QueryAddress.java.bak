package org.cardanoJ.transaction;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.IOException;

import static org.cardanoJ.transaction.Constant.SOCKET_PATH;

public class QueryAddress {
    public long queryAddress(String cliPath, String resourcePath, String address, String network) {
        try {
            ProcessBuilder processBuilder = new ProcessBuilder(
                    cliPath, "query", "utxo",
                    "--address", address,
                    network.contains("testnet") ? "--testnet-magic" : network,
                    "2",
                    "--socket-path", SOCKET_PATH // define your own cardano Node path
            );
            System.out.println("Query: "+ processBuilder.command());
            processBuilder.redirectOutput(new File(resourcePath + "query.txt"));

            Process process = processBuilder.start();
            process.waitFor();

            return query(resourcePath + "query.txt");
        } catch (IOException | InterruptedException e) {
            e.printStackTrace();
            return -1;
        }
    }

    private long query(String filePath) {
        try (BufferedReader reader = new BufferedReader(new FileReader(filePath))) {
            reader.readLine();
            reader.readLine();
            String line;
            long maxLovelace = 0;
            while ((line = reader.readLine()) != null) {
                String[] parts = line.trim().split("\\s+");
                long lovelace = parseLovelace(parts[2]);
                    maxLovelace = lovelace + maxLovelace;
            }
            return maxLovelace;
        } catch (IOException e) {
            e.printStackTrace();
            return -1;
        }
    }
    private static long parseLovelace(String amount) {
        String[] tokens = amount.split("\\s+");
        return Long.parseLong(tokens[0]);
    }


}
